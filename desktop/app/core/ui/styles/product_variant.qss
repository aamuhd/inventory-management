/* =========================================================
   PRODUCT VARIANT WINDOW
   ========================================================= */

#productVariantWindow {
    background-color: #1b1b1b;
}


/* =========================================================
   FORM CONTAINER
   ========================================================= */

#productVariantFormContainer {
    background-color: #202020;

    border: 1px solid #363636;
    border-radius: 8px;
}


/* =========================================================
   FORM TITLE
   ========================================================= */

#productVariantFormTitle {
    color: #ffffff;

    font-size: 17px;
    font-weight: 600;

    padding-bottom: 5px;
}


/* =========================================================
   FORM LABELS
   ========================================================= */

#productVariantFormContainer QLabel {
    color: #cfcfcf;

    font-size: 13px;
    font-weight: 500;
}


/* =========================================================
   INPUTS
   ========================================================= */

#productVariantFormContainer QLineEdit,
#productVariantFormContainer QComboBox,
#productVariantFormContainer QSpinBox,
#productVariantFormContainer QDoubleSpinBox {
    background-color: #252525;

    color: #eeeeee;

    border: 1px solid #404040;
    border-radius: 6px;

    padding: 6px 9px;

    min-height: 20px;
}


/* =========================================================
   INPUT FOCUS
   ========================================================= */

#productVariantFormContainer QLineEdit:focus,
#productVariantFormContainer QComboBox:focus,
#productVariantFormContainer QSpinBox:focus,
#productVariantFormContainer QDoubleSpinBox:focus {
    border: 1px solid #4c9aff;
}


/* =========================================================
   INPUT DISABLED
   ========================================================= */

#productVariantFormContainer QLineEdit:disabled,
#productVariantFormContainer QComboBox:disabled,
#productVariantFormContainer QSpinBox:disabled,
#productVariantFormContainer QDoubleSpinBox:disabled {
    background-color: #202020;

    color: #666666;

    border: 1px solid #333333;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

#productVariantFormContainer QComboBox {
    padding-right: 10px;
}

#productVariantFormContainer QComboBox::drop-down {
    border: none;

    width: 25px;
}

#productVariantFormContainer QComboBox QAbstractItemView {
    background-color: #252525;

    color: #eeeeee;

    border: 1px solid #404040;

    selection-background-color: #354b61;
    selection-color: #ffffff;
}


/* =========================================================
   SPIN BOX
   ========================================================= */

#productVariantFormContainer QSpinBox {
    padding-right: 8px;
}

#productVariantFormContainer QSpinBox::up-button,
#productVariantFormContainer QSpinBox::down-button {
    background-color: #303030;

    border: none;

    width: 18px;
}

#productVariantFormContainer QSpinBox::up-button:hover,
#productVariantFormContainer QSpinBox::down-button:hover {
    background-color: #3a3a3a;
}


/* =========================================================
   DOUBLE SPIN BOX / PRICE INPUTS
   ========================================================= */

#productVariantFormContainer QDoubleSpinBox {
    padding-right: 8px;
}

#productVariantFormContainer QDoubleSpinBox::up-button,
#productVariantFormContainer QDoubleSpinBox::down-button {
    background-color: #303030;

    border: none;

    width: 18px;
}

#productVariantFormContainer QDoubleSpinBox::up-button:hover,
#productVariantFormContainer QDoubleSpinBox::down-button:hover {
    background-color: #3a3a3a;
}


/* =========================================================
   SAVE BUTTON
   ========================================================= */

#productVariantSaveButton {
    background-color: #3d7eff;

    color: #ffffff;

    border: none;
    border-radius: 6px;

    font-size: 13px;
    font-weight: 600;

    padding: 8px 16px;
}

#productVariantSaveButton:hover {
    background-color: #528eff;
}

#productVariantSaveButton:pressed {
    background-color: #326bd6;
}

#productVariantSaveButton:disabled {
    background-color: #303030;

    color: #666666;
}


/* =========================================================
   CLEAR BUTTON
   ========================================================= */

#productVariantClearButton {
    background-color: #303030;

    color: #dddddd;

    border: 1px solid #464646;
    border-radius: 6px;

    font-size: 13px;
    font-weight: 500;

    padding: 8px 16px;
}

#productVariantClearButton:hover {
    background-color: #3a3a3a;

    color: #ffffff;
}

#productVariantClearButton:pressed {
    background-color: #282828;
}


/* =========================================================
   DELETE BUTTON
   ========================================================= */

#productVariantDeleteButton {
    background-color: #3a2525;

    color: #f0b0b0;

    border: 1px solid #633737;
    border-radius: 6px;

    font-size: 13px;
    font-weight: 600;

    padding: 8px 16px;
}

#productVariantDeleteButton:hover {
    background-color: #542d2d;

    color: #ffffff;
}

#productVariantDeleteButton:pressed {
    background-color: #322020;
}

#productVariantDeleteButton:disabled {
    background-color: #292929;

    color: #666666;

    border: 1px solid #353535;
}


/* =========================================================
   SPLITTER
   ========================================================= */

#productVariantSplitter::handle {
    background-color: #363636;

    width: 2px;
}

#productVariantSplitter::handle:hover {
    background-color: #4c9aff;
}


/* =========================================================
   TABLE
   ========================================================= */

#productVariantTable {
    background-color: #222222;

    alternate-background-color: #252525;

    color: #eeeeee;

    border: 1px solid #363636;
    border-radius: 6px;

    gridline-color: #333333;
}


/* =========================================================
   TABLE ITEMS
   ========================================================= */

#productVariantTable::item {
    padding: 7px;
}

#productVariantTable::item:selected {
    background-color: #354b61;

    color: #ffffff;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

#productVariantTable QHeaderView::section {
    background-color: #292929;

    color: #bbbbbb;

    border: none;
    border-bottom: 1px solid #3d3d3d;

    padding: 7px 6px;

    font-size: 13px;
    font-weight: 600;
}


/* =========================================================
   TABLE CORNER
   ========================================================= */

#productVariantTable QTableCornerButton::section {
    background-color: #292929;

    border: none;
    border-bottom: 1px solid #3d3d3d;
}


/* =========================================================
   SCROLLBARS
   ========================================================= */

#productVariantTable QScrollBar:vertical {
    background-color: #202020;

    width: 10px;

    border: none;
}

#productVariantTable QScrollBar::handle:vertical {
    background-color: #454545;

    border-radius: 5px;

    min-height: 25px;
}

#productVariantTable QScrollBar::handle:vertical:hover {
    background-color: #555555;
}

#productVariantTable QScrollBar::add-line:vertical,
#productVariantTable QScrollBar::sub-line:vertical {
    height: 0px;
}

#productVariantTable QScrollBar:horizontal {
    background-color: #202020;

    height: 10px;

    border: none;
}

#productVariantTable QScrollBar::handle:horizontal {
    background-color: #454545;

    border-radius: 5px;

    min-width: 25px;
}

#productVariantTable QScrollBar::handle:horizontal:hover {
    background-color: #555555;
}

#productVariantTable QScrollBar::add-line:horizontal,
#productVariantTable QScrollBar::sub-line:horizontal {
    width: 0px;
}