/* =========================================================
   CUSTOMER WINDOW
   ========================================================= */

#customerWindow {
    background-color: #1b1b1b;
}


/* =========================================================
   CUSTOMER FORM PANEL
   ========================================================= */

#customerFormPanel {
    background-color: #242424;

    border: 1px solid #363636;
    border-radius: 8px;

    padding: 0;
}


/* =========================================================
   CUSTOMER FORM
   ========================================================= */

#customerForm {
    background-color: transparent;
}


/* =========================================================
   FORM LABELS
   ========================================================= */

#customerForm QLabel {
    color: #dddddd;

    font-size: 13px;
    font-weight: 600;
}


/* =========================================================
   INPUTS
   ========================================================= */

#customerForm QLineEdit,
#customerForm QTextEdit {
    background-color: #202020;

    color: #ffffff;

    border: 1px solid #464646;
    border-radius: 6px;

    padding: 7px;

    font-size: 13px;
}


/* =========================================================
   INPUT FOCUS
   ========================================================= */

#customerForm QLineEdit:focus,
#customerForm QTextEdit:focus {
    border: 1px solid #4d90fe;
}


/* =========================================================
   PLACEHOLDER TEXT
   ========================================================= */

#customerForm QLineEdit {
    selection-background-color: #354b61;
    selection-color: #ffffff;
}


/* =========================================================
   CUSTOMER ADDRESS
   ========================================================= */

#customerAddressInput {
    padding: 7px;

    line-height: 1.3;
}


/* =========================================================
   FORM BUTTONS
   ========================================================= */

#customerSaveButton,
#customerClearButton,
#customerDeleteButton {
    min-height: 36px;

    border-radius: 6px;

    padding: 0 16px;

    font-size: 13px;
    font-weight: 600;
}


/* =========================================================
   SAVE BUTTON
   ========================================================= */

#customerSaveButton {
    background-color: #3d7eff;

    color: #ffffff;

    border: none;
}

#customerSaveButton:hover {
    background-color: #528eff;
}

#customerSaveButton:pressed {
    background-color: #326bd6;
}


/* =========================================================
   CLEAR BUTTON
   ========================================================= */

#customerClearButton {
    background-color: #303030;

    color: #dddddd;

    border: 1px solid #464646;
}

#customerClearButton:hover {
    background-color: #3a3a3a;

    color: #ffffff;
}

#customerClearButton:pressed {
    background-color: #282828;
}


/* =========================================================
   DELETE CUSTOMER
   ========================================================= */

#customerDeleteButton {
    background-color: #4a2929;

    color: #ffb0b0;

    border: 1px solid #663838;
}

#customerDeleteButton:hover {
    background-color: #5a3030;

    color: #ffffff;
}

#customerDeleteButton:pressed {
    background-color: #3d2222;
}

#customerDeleteButton:disabled {
    background-color: #292929;

    color: #666666;

    border: 1px solid #353535;
}


/* =========================================================
   CUSTOMER TABLE
   ========================================================= */

#customerTableWidget {
    background-color: #222222;

    alternate-background-color: #252525;

    color: #eeeeee;

    border: 1px solid #363636;
    border-radius: 6px;

    gridline-color: #333333;
}


/* =========================================================
   TABLE ITEMS
   ========================================================= */

#customerTableWidget::item {
    padding: 7px;
}

#customerTableWidget::item:selected {
    background-color: #354b61;

    color: #ffffff;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

#customerTableWidget QHeaderView::section {
    background-color: #292929;

    color: #bbbbbb;

    border: none;
    border-bottom: 1px solid #3d3d3d;

    padding: 8px;

    font-size: 13px;
    font-weight: 600;
}


/* =========================================================
   TABLE CORNER
   ========================================================= */

#customerTableWidget QTableCornerButton::section {
    background-color: #292929;

    border: none;
}


/* =========================================================
   SCROLLBARS
   ========================================================= */

#customerTableWidget QScrollBar:vertical {
    background-color: #202020;

    width: 10px;

    margin: 0;
}

#customerTableWidget QScrollBar::handle:vertical {
    background-color: #464646;

    min-height: 30px;

    border-radius: 5px;
}

#customerTableWidget QScrollBar::handle:vertical:hover {
    background-color: #555555;
}

#customerTableWidget QScrollBar::add-line:vertical,
#customerTableWidget QScrollBar::sub-line:vertical {
    height: 0;
}

#customerTableWidget QScrollBar:horizontal {
    background-color: #202020;

    height: 10px;

    margin: 0;
}

#customerTableWidget QScrollBar::handle:horizontal {
    background-color: #464646;

    min-width: 30px;

    border-radius: 5px;
}

#customerTableWidget QScrollBar::handle:horizontal:hover {
    background-color: #555555;
}

#customerTableWidget QScrollBar::add-line:horizontal,
#customerTableWidget QScrollBar::sub-line:horizontal {
    width: 0;
}


/* =========================================================
   SPLITTER
   ========================================================= */

#customerSplitter::handle {
    background-color: #363636;

    width: 4px;
}

#customerSplitter::handle:hover {
    background-color: #4d90fe;
}