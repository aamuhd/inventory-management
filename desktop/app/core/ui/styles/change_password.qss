/* =========================================================
   CHANGE PASSWORD WINDOW
   ========================================================= */

#changePasswordWindow {
    background-color: #1b1b1b;
}

/* =========================================================
   CHANGE PASSWORD FORM
   ========================================================= */

#changePasswordForm {
    background-color: #202020;
}

/* =========================================================
   TITLE
   ========================================================= */

#changePasswordTitle {
    color: #ffffff;

    font-size: 24px;
    font-weight: 600;

    padding-bottom: 2px;
}

/* =========================================================
   DESCRIPTION
   ========================================================= */

#changePasswordDescription {
    color: #a8a8a8;

    font-size: 13px;

    line-height: 1.4;
}

/* =========================================================
   FORM LABELS
   ========================================================= */

#changePasswordForm QLabel {
    color: #d6d6d6;

    font-size: 13px;
}

/* =========================================================
   PASSWORD INPUTS
   ========================================================= */

#changePasswordEdit,
#changePasswordConfirmEdit {
    background-color: #292929;

    color: #ffffff;

    border: 1px solid #414141;
    border-radius: 5px;

    padding: 9px 11px;

    min-height: 18px;

    selection-background-color: #3d6ea8;
}

#changePasswordEdit:hover,
#changePasswordConfirmEdit:hover {
    border: 1px solid #555555;
}

#changePasswordEdit:focus,
#changePasswordConfirmEdit:focus {
    border: 1px solid #4d8dcc;

    background-color: #2c2c2c;
}

/* =========================================================
   PLACEHOLDER TEXT
   ========================================================= */

#changePasswordEdit,
#changePasswordConfirmEdit {
    font-size: 13px;
}

/* =========================================================
   CHANGE PASSWORD BUTTON
   ========================================================= */

#changePasswordButton {
    background-color: #3d6ea8;

    color: #ffffff;

    border: 1px solid #4d7fba;
    border-radius: 5px;

    font-size: 14px;
    font-weight: 600;

    padding: 10px 16px;
}

#changePasswordButton:hover {
    background-color: #4a7fbd;
}

#changePasswordButton:pressed {
    background-color: #345f91;
}

#changePasswordButton:disabled {
    background-color: #303030;

    color: #707070;

    border: 1px solid #3a3a3a;
}