/* =========================================================
   SETTINGS WINDOW
   ========================================================= */


#settingsContent {
    background: transparent;
}


#settingsHeader {
    font-size: 24px;
    font-weight: bold;
    padding: 4px 0;
}


#settingsDescription {
    font-size: 13px;
    padding-bottom: 4px;
}


/* =========================================================
   GROUP BOXES
   ========================================================= */


QGroupBox {
    font-weight: bold;
    padding-top: 18px;
}


QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
}


/* =========================================================
   INPUTS
   ========================================================= */


#settingsContent QLineEdit,
#settingsContent QTextEdit {
    min-height: 34px;
    padding: 5px 8px;
}


#settingsContent QTextEdit {
    min-height: 90px;
}


#settingsContent QCheckBox {
    padding: 5px 0;
}


/* =========================================================
   PASSWORD RECOVERY
   ========================================================= */


#settingsRecoveryDescription {
    font-size: 13px;
    padding: 2px 0;
}


#settingsRecoveryStatus {
    font-size: 12px;
    padding: 2px 0;
}


#settingsGenerateRecoveryCodeButton {
    min-height: 38px;
    font-weight: bold;
    padding: 0 16px;
}


/* =========================================================
   BUTTONS
   ========================================================= */


#settingsSaveButton {
    min-height: 38px;
    font-weight: bold;
    padding: 0 16px;
}


#settingsCancelButton {
    min-height: 38px;
    padding: 0 16px;
}
